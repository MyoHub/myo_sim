        <pair geom1="bofoot_col1_l" geom2="foot_col3_r" condim="1"/>
        <pair geom1="bofoot_col2_l" geom2="foot_col3_r" condim="1"/>
        <pair geom1="bofoot_col1_l" geom2="foot_col1_r" condim="1"/>
        <pair geom1="bofoot_col2_l" geom2="foot_col1_r" condim="1"/>
        <pair geom1="foot_col1_r" geom2="foot_col1_l" condim="1"/>
        <pair geom1="foot_col4_r" geom2="foot_col4_l" condim="1"/>
    </contact>


    <asset>
        <texture name="myolegs_tex" builtin="flat" height="762" mark="cross" markrgb="1 .9 .9" rgb1="1 1 1" rgb2="1 1 1" type="cube" width="127"/>
        <material name="myolegs_mat" texture="myolegs_tex" texuniform="true"/>
        <material name="myoleg_matskin" specular="0.2" shininess=".1" reflectance="0.5" rgba="0.8 0.7 .5 .1" />

        <mesh file="../myo_sim/meshes/r_pelvis.stl" name="r_pelvis"/>
        <mesh file="../myo_sim/meshes/l_pelvis.stl" name="l_pelvis"/>
        <mesh file="../myo_sim/meshes/r_femur.stl" name="r_femur"/>
        <mesh file="../myo_sim/meshes/r_tibia.stl" name="r_tibia"/>
        <mesh file="../myo_sim/meshes/r_fibula.stl" name="r_fibula"/>
        <mesh file="../myo_sim/meshes/r_talus.stl" name="r_talus"/>
        <mesh file="../myo_sim/meshes/r_foot.stl" name="r_foot"/>
        <mesh file="../myo_sim/meshes/r_bofoot.stl" name="r_bofoot"/>
        <mesh file="../myo_sim/meshes/r_patella.stl" name="r_patella"/>
        <mesh file="../myo_sim/meshes/l_femur.stl" name="l_femur"/>
        <mesh file="../myo_sim/meshes/l_tibia.stl" name="l_tibia"/>
        <mesh file="../myo_sim/meshes/l_fibula.stl" name="l_fibula"/>
        <mesh file="../myo_sim/meshes/l_talus.stl" name="l_talus"/>
        <mesh file="../myo_sim/meshes/l_foot.stl" name="l_foot"/>
        <mesh file="../myo_sim/meshes/l_bofoot.stl" name="l_bofoot"/>
        <mesh file="../myo_sim/meshes/l_patella.stl" name="l_patella"/>
    </asset>

    <equality>
        <joint joint1="knee_angle_translation2_r" joint2="knee_angle_r" name="knee_angle_translation2_constraint_r" polycoef="7.69254e-11 0.00587971 -0.00125622 -2.61846e-06 6.24355e-07" solimp="0.9999 0.9999 0.001 0.5 2"/>
        <joint joint1="knee_angle_translation1_r" joint2="knee_angle_r" name="knee_angle_translation1_constraint_r" polycoef="9.53733e-08 0.00312879 -0.00230804 0.000561561 5.68366e-07" solimp="0.9999 0.9999 0.001 0.5 2"/>
        <joint joint1="knee_angle_rotation2_r" joint2="knee_angle_r" name="knee_angle_rotation2_constraint_r" polycoef="-1.47325e-08 0.0791 -0.0328478 -0.0252183 0.0108321" solimp="0.9999 0.9999 0.001 0.5 2"/>
