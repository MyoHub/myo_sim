    <compiler angle="radian" inertiafromgeom="auto"/>
    <option timestep="0.001"/>

    <size nconmax="2000" njmax="5000" nkey="1" nuser_jnt="1"/>
    <!-- <visual>
        <headlight ambient=".5 .5 .5" diffuse="0.50 0.50 0.50" specular="0.50 0.50 0.50"/>
    </visual> -->
    <default>
        <default class="myolegs">
            <joint armature="0.01" damping="0.5" limited="true"/>
            <geom margin="0.001" material="myolegs_mat" rgba="0.8 0.8 0.8 1" conaffinity="0" contype="0"/>
            <site size="0.001 0.005 0.005" group="3"/>
            <default class="myoleg_muscle">
                <tendon rgba="0.95 0.3 0.3 1" width="0.005"/>
                <general biasprm="0.75 1.05 -1 400 0.5 1.6 1.5 1.3 1.2 0" biastype="muscle" ctrllimited="true" ctrlrange="0 1" dynprm="0.01 0.04 0 0 0 0 0 0 0 0" dyntype="muscle" gainprm="0.75 1.05 -1 400 0.5 1.6 1.5 1.3 1.2 0" gaintype="muscle"/>
            </default>
            <default class="myoleg_wrap">
                <geom rgba=".5 .5 .9 0.5" group="3" contype="0" conaffinity="0"  type="cylinder"/>
            </default>
            <default class="coll">
                <geom type="capsule" mass="0" group="4" contype="1" conaffinity="0" condim="3" rgba="0.8 0.7 .5 .1" margin="0.001" material="myoleg_matskin"/>
            </default>
            <default class="myo_leg_touch">
                <site type="box" group="3" rgba="0.8 0.2 .2 .4"/>
            </default>
            <default class="myo_leg_marker">
                <site size="0.02" group="4" rgba="0.8 0.8 .2 1"/>
            </default>
        </default>
    </default>

    <contact>
        <pair geom1="femur1_col_r" geom2="femur1_col_l" condim="1"/>
        <pair geom1="femur2_col_r" geom2="femur2_col_l" condim="1"/>
        <pair geom1="tibia1_col_r" geom2="tibia1_col_l" condim="1"/>
        <pair geom1="tibia2_col_r" geom2="tibia2_col_l" condim="1"/>

        <pair geom1="femur1_col_r" geom2="tibia1_col_l" condim="1"/>
        <pair geom1="femur1_col_l" geom2="tibia1_col_r" condim="1"/>

        <pair geom1="femur2_col_r" geom2="tibia1_col_l" condim="1"/>
        <pair geom1="femur2_col_l" geom2="tibia1_col_r" condim="1"/>

        <pair geom1="femur1_col_r" geom2="tibia2_col_l" condim="1"/>
        <pair geom1="femur1_col_l" geom2="tibia2_col_r" condim="1"/>

        <pair geom1="femur2_col_r" geom2="tibia2_col_l" condim="1"/>
        <pair geom1="femur2_col_l" geom2="tibia2_col_r" condim="1"/>

        <pair geom1="bofoot_col1_r" geom2="foot_col4_l" condim="1"/>
        <pair geom1="bofoot_col2_r" geom2="foot_col4_l" condim="1"/>
        <pair geom1="bofoot_col1_r" geom2="foot_col3_l" condim="1"/>
        <pair geom1="bofoot_col2_r" geom2="foot_col3_l" condim="1"/>
