        <joint joint1="knee_angle_beta_translation1_r" joint2="knee_angle_r" name="knee_angle_beta_translation1_constraint_r" polycoef="0.0524192 -0.0150188 -0.0340522 0.0133393 -0.000879151" solimp="0.9999 0.9999 0.001 0.5 2"/>
        <joint joint1="knee_angle_beta_rotation1_r" joint2="knee_angle_r" name="knee_angle_beta_rotation1_constraint_r" polycoef="0.010506 0.0247615 -1.31647 0.716337 -0.138302" solimp="0.9999 0.9999 0.001 0.5 2"/>
