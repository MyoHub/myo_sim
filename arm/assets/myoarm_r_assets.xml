        <mesh name="2mc_r" file="../myo_sim/meshes/2mc.stl" scale="1 1 1"/>
        <mesh name="2proxph_r" file="../myo_sim/meshes/2proxph.stl" scale="1 1 1"/>
        <mesh name="2midph_r" file="../myo_sim/meshes/2midph.stl" scale="1 1 1"/>
        <mesh name="2distph_r" file="../myo_sim/meshes/2distph.stl" scale="1 1 1"/>
        <mesh name="3mc_r" file="../myo_sim/meshes/3mc.stl" scale="1 1 1"/>
        <mesh name="3proxph_r" file="../myo_sim/meshes/3proxph.stl" scale="1 1 1"/>
        <mesh name="3midph_r" file="../myo_sim/meshes/3midph.stl" scale="1 1 1"/>
        <mesh name="3distph_r" file="../myo_sim/meshes/3distph.stl" scale="1 1 1"/>
        <mesh name="4mc_r" file="../myo_sim/meshes/4mc.stl" scale="1 1 1"/>
        <mesh name="4proxph_r" file="../myo_sim/meshes/4proxph.stl" scale="1 1 1"/>
        <mesh name="4midph_r" file="../myo_sim/meshes/4midph.stl" scale="1 1 1"/>
        <mesh name="4distph_r" file="../myo_sim/meshes/4distph.stl" scale="1 1 1"/>
