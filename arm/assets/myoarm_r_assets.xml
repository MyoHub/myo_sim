        <joint joint1="unrotscap_r3_r" joint2="shoulder_elv_r" name="unrotscap_r3_con_r" polycoef="0 -0.1025 0 0 0" solimp="0.9999 0.9999 0.001 0.5 2"/>
        <joint joint1="acromioclavicular_r1_r" joint2="shoulder_elv_r" name="acromioclavicular_r1_con_r" polycoef="0 0.178 0 0 0" solimp="0.9999 0.9999 0.001 0.5 2"/>
        <joint joint1="acromioclavicular_r2_r" joint2="shoulder_elv_r" name="acromioclavicular_r2_con_r" polycoef="0 -0.049 0 0 0" solimp="0.9999 0.9999 0.001 0.5 2"/>
        <joint joint1="acromioclavicular_r3_r" joint2="shoulder_elv_r" name="acromioclavicular_r3_con_r" polycoef="0 0.396 0 0 0" solimp="0.9999 0.9999 0.001 0.5 2"/>
        <joint joint1="unrothum_r1_r" joint2="shoulder_elv_r" name="unrothum_r1_con_r" polycoef="0 -0.178 0 0 0" solimp="0.9999 0.9999 0.001 0.5 2"/>
        <joint joint1="unrothum_r2_r" joint2="shoulder_elv_r" name="unrothum_r2_con_r" polycoef="0 0.049 0 0 0" solimp="0.9999 0.9999 0.001 0.5 2"/>
        <joint joint1="unrothum_r3_r" joint2="shoulder_elv_r" name="unrothum_r3_con_r" polycoef="0 -0.396 0 0 0" solimp="0.9999 0.9999 0.001 0.5 2"/>
