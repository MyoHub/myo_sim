<?xml version='1.0' encoding='utf-8'?>
<mujocoinclude>
    <!-- Cross-part contact pairs: arm radius geoms (arm) <-> femur/tibia geoms (leg).
         These live here because neither the arm nor the leg part owns both geom names. -->
    <contact>
        <pair geom1="radius_coll_r" geom2="femur2_col_r" condim="3" />
        <pair geom1="radius_coll_r" geom2="femur1_col_r" condim="3" />
        <pair geom1="radius_coll_r" geom2="tibia1_col_r" condim="3" />
        <pair geom1="radius_coll_r" geom2="tibia2_col_r" condim="3" />

        <pair geom1="radius_coll_l" geom2="femur2_col_l" condim="3" />
        <pair geom1="radius_coll_l" geom2="femur1_col_l" condim="3" />
        <pair geom1="radius_coll_l" geom2="tibia1_col_l" condim="3" />
        <pair geom1="radius_coll_l" geom2="tibia2_col_l" condim="3" />

        <pair geom1="radius_coll_l" geom2="femur2_col_r" condim="3" />
        <pair geom1="radius_coll_l" geom2="femur1_col_r" condim="3" />
        <pair geom1="radius_coll_l" geom2="tibia1_col_r" condim="3" />
        <pair geom1="radius_coll_l" geom2="tibia2_col_r" condim="3" />

        <pair geom1="radius_coll_r" geom2="femur2_col_l" condim="3" />
        <pair geom1="radius_coll_r" geom2="femur1_col_l" condim="3" />
        <pair geom1="radius_coll_r" geom2="tibia1_col_l" condim="3" />
        <pair geom1="radius_coll_r" geom2="tibia2_col_l" condim="3" />
    </contact>
</mujocoinclude>
