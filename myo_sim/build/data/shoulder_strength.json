{
  "format": "myo_sim.shoulder_strength/1",
  "description": "One specific tension for the shoulder muscles (glenohumeral muscles kept from MoBL-ARMS, rotator cuff, scapular muscles), calibrated to measured maximal isometric shoulder moments of young men; scripts/fit_shoulder_strength.py. Elbow muscles (biceps, triceps) keep their forces; passive force stays a fixed fraction of each muscle's peak force.",
  "reference_subject": "Young adult man, as for the hand's specific tension (specific_tension.json): the model's geometry is a 50th-percentile male's and most shoulder data are from men.",
  "sources": {
    "holzbaur2005": {
      "citation": "Holzbaur KRS, Murray WM, Delp SL. A model of the upper extremity for simulating musculoskeletal surgery and analyzing neuromuscular control. Ann Biomed Eng 33(6):829-840, 2005.",
      "doi": "10.1007/s10439-005-3320-7",
      "location": "Table 1 (PCSA from Langenderfer et al. 2004, distributed among compartments to match isometric moments); Fig. 4 (experimental moment-angle curves, digitised, no spread)"
    },
    "holzbaur2007": {
      "citation": "Holzbaur KRS, Delp SL, Gold GE, Murray WM. Moment-generating capacity of upper limb muscles in healthy adults. J Biomech 40(11):2442-2449, 2007.",
      "doi": "10.1016/j.jbiomech.2006.11.013",
      "location": "Table 1, men (n = 5): Biodex, seated, trunk strapped, shoulder at 60 deg abduction, elbow braced extended"
    },
    "smith2001": {
      "citation": "Smith J, Padgett DJ, Kotajarvi BR, Eischen JJ. Isokinetic and isometric shoulder rotation strength in the protracted position: a reliability study. Isokinetics Exerc Sci 9:119-127, 2001.",
      "location": "Tables 2-3, men (n = 5), mean of days 1 and 2: KIN-COM, seated, 45 deg scapular-plane abduction, elbow 90 deg, 45 deg external rotation test angle"
    },
    "aronis2025": {
      "citation": "Aronis G, Kurz M, Wimmer F, Hackl H, Angeli T, Gfohler M. Maximum shoulder torque and muscle activation during standing arm flexion. J Funct Morphol Kinesiol 11(1):20, 2025.",
      "doi": "10.3390/jfmk11010020",
      "location": "Table 1, 90 deg flexion, men (n = 14), standing, elbow extended, gravity torque added"
    },
    "harbo2012": {
      "citation": "Harbo T, Brincks J, Andersen H. Maximal isokinetic and isometric muscle strength of major muscle groups related to age, body mass, height, and sex in 178 healthy subjects. Eur J Appl Physiol 112:267-275, 2012.",
      "doi": "10.1007/s00421-011-1975-3",
      "location": "Table 3, isometric abduction at the neutral position (arm at the side), men (n = 79, 15-83 y), Biodex, seated, gravity corrected; elbow position not stated (90 deg assumed)"
    },
    "roy2009": {
      "citation": "Roy JS, MacDermid JC, Boyd KU, Faber KJ, Drosdowech D, Athwal GS. Rotational strength, range of motion, and function in people with unaffected shoulders from various stages of life. Sports Med Arthrosc Rehabil Ther Technol 1:4, 2009.",
      "doi": "10.1186/1758-2555-1-4",
      "location": "Table 2, men 18-39 y, dominant side: seated, 45 deg scapular-plane abduction (30 deg forward of the frontal plane), elbow 90 deg, neutral rotation"
    },
    "otis1990": {
      "citation": "Otis JC, Warren RF, Backus SI, Santner TJ, Mabrey JD. Torque production in the shoulder of the normal young adult male. Am J Sports Med 18(2):119-123, 1990.",
      "doi": "10.1177/036354659001800201",
      "location": "as reported in Holzbaur et al. 2005 Fig. 4 (digitised, no spread; 36 young men)"
    },
    "garner2001": {
      "citation": "Garner BA, Pandy MG. Musculoskeletal model of the upper limb based on the visible human male dataset. Comput Methods Biomech Biomed Engin 4(2):93-126, 2001.",
      "doi": "10.1080/10255840008908000",
      "location": "experimental curves as reported in Holzbaur et al. 2005 Fig. 4 (digitised, no spread)"
    },
    "hannah2017": {
      "citation": "Hannah DC, Scibek JS, Carcia CR. Strength profiles in healthy individuals with and without scapular dyskinesis. Int J Sports Phys Ther 12(3):305-313, 2017.",
      "location": "Table 2: seated shrug against a handheld dynamometer on the acromion, 0.310 +- 0.069 body weight (26 young adults, 6 men)"
    },
    "garner2008": {
      "citation": "Garner BA, Shim J. Isometric shoulder girdle strength of healthy young adults. Clin Biomech 23(1):30-37, 2008.",
      "doi": "10.1016/j.clinbiomech.2007.07.018",
      "location": "abstract: peak elevation 1101 +- 370 N, protraction 1117 +- 471 N, seated apparatus pushed with extended arms (19 young adults; whether bilateral is not stated in the abstract)"
    },
    "ijspeert2019": {
      "citation": "IJspeert J, Kerstens HCJW, Janssen RMJ, Geurts ACH, van Alfen N, Groothuis JT. Validity and reliability of serratus anterior hand held dynamometry. BMC Musculoskelet Disord 20:360, 2019.",
      "doi": "10.1186/s12891-019-2741-6",
      "location": "Table 2: supine, shoulder 90 deg flexion, elbow 90 deg, handheld dynamometer below the olecranon, 383.9 +- 77.7 N (21 healthy adults, 15 men)"
    },
    "ward2006": {
      "citation": "Ward SR, Hentzen ER, Smallwood LH, Eastlack RK, Burns KA, Fithian DC, Friden J, Lieber RL. Rotator cuff muscle architecture: implications for glenohumeral stability. Clin Orthop Relat Res 448:157-163, 2006.",
